@ARTICLE{Coelho2024,
	author = {Coelho, Rebeca Durço and Viana, Camila Duelis and Dias, Vivian Cristina and Grohmann, Carlos Henrique},
	title = {Landslides of the 2023 summer event of São Sebastião, southeastern Brazil: spatial dataset},
	year = {2024},
	journal = {Brazilian Journal of Geology},
	volume = {54},
	number = {2},
	pages = {},
	doi = {10.1590/2317-4889202420240006},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105003221955&doi=10.1590%2F2317-4889202420240006&partnerID=40&md5=239be802b9edf98127ecf289b9e5874f},
	affiliations = {Universidade de São Paulo, Instituto de Geociências, Sao Paulo, SP, Brazil; Universidade de São Paulo, Sao Paulo, SP, Brazil; Universidade de São Paulo, Institute of Astronomy, Sao Paulo, SP, Brazil; Universidade de São Paulo, Spatial Analysis and Modelling Lab (SPAMLab), Sao Paulo, SP, Brazil},
	abstract = {In February 2023, anomalously heavy rainfall caused widespread landslides in the coastal city of São Sebastião (Southeastern Brazil). This report describes the first version of a landslide inventory dataset for this event. The inventory is primarily based on the analysis of aerial images with 10 cm spatial resolution acquired immediately after the event, as well as archive images from Google Earth and PlanetScope. Delimitation of the landslides relied on a comparison of the images along with the area’s Digital Surface Model (DSM) and hydrography. The spatial vector dataset (shapefile and geopackage) contains points representing the landslide’s crowns and polygons indicating the affected area and is openly available in Zenodo. © 2024 The authors.},
	author_keywords = {digital terrain analysis; GIS; landslide dataset; mass movement},
	correspondence_address = {C.H. Grohmann; Universidade de São Paulo, Instituto de Astronomia, Geofísica e Ciências Atmosféricas, São Paulo, SP, Brazil; email: guano@usp.br},
	publisher = {Sociedade Brasileira de Geologia},
	issn = {23174889},
	language = {English},
	abbrev_source_title = {Breaz. J. Geol.},
	type = {Data paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 5; All Open Access; Gold Open Access}
}

